  {
    "id": "metodo",
    "nome": "Metodo",
    "enabled": true,
    "html": "<div class=\"gc\"><section class=\"gc-sec gc-soft\" id=\"metodo\"><div class=\"gc-wrap\"><p class=\"gc-eyebrow\">Our method</p><h2 class=\"gc-h2\">Four steps, no surprises</h2><div class=\"gc-plat ent-4\"><div class=\"gc-pl\"><span class=\"n\">01</span><b>Check</b><p>We look closely at the problem and its causes.</p></div><div class=\"gc-pl\"><span class=\"n\">02</span><b>Proposal</b><p>We explain what to do, in what order and with which materials.</p></div><div class=\"gc-pl\"><span class=\"n\">03</span><b>Works</b><p>One contact follows the site and answers your questions.</p></div><div class=\"gc-pl\"><span class=\"n\">04</span><b>Handover</b><p>We leave you photos and a final report of the works.</p></div></div></div></section></div>"
