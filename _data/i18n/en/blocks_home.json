    "nome": "Per chi",
    "enabled": true,
    "html": "<div class=\"gc\"><section class=\"gc-sec\" id=\"perchi\"><div class=\"gc-wrap\"><p class=\"gc-eyebrow\">Our clients</p><h2 class=\"gc-h2\">Who we work for</h2><div class=\"gc-plat\"><div class=\"gc-pl ent-pl\"><b>Condominiums and managers</b><p>Planned maintenance, urgent jobs and documents ready for the meeting.</p></div><div class=\"gc-pl ent-pl\"><b>Homeowners</b><p>From the leaking balcony to a full renovation.</p></div><div class=\"gc-pl ent-pl\"><b>Businesses and professionals</b><p>Inspections, surveys and specialist work at height.</p></div></div></div></section></div>"
